{
  "name": "owlfolio-v02",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "bin": { "owlfolio": "./owlfolio" },
  "scripts": {
    "dev": "NODE_OPTIONS=--disable-warning=ExperimentalWarning corepack pnpm --filter @owlfolio/web dev",
    "worker": "corepack pnpm --filter @owlfolio/worker dev",
    "owlfolio": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx apps/cli/src/index.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run --passWithNoTests",
    "test:watch": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest --passWithNoTests",
    "lint": "corepack pnpm -r lint",
    "typecheck": "tsc --noEmit -p tsconfig.json && corepack pnpm -r typecheck",
    "e2e": "NODE_OPTIONS=--disable-warning=ExperimentalWarning playwright test",
    "certify:providers": "tsx scripts/certify-providers.mjs",
    "qualify:models": "tsx scripts/qualify-models.mjs",
    "ops:backup:inventory": "tsx scripts/owlfolio-local-backup-cli.ts inventory",
    "ops:backup:manifest": "tsx scripts/owlfolio-local-backup-cli.ts manifest",
    "ops:restore:dry-run": "tsx scripts/owlfolio-local-backup-cli.ts restore-dry-run",
    "ops:restore:verify": "tsx scripts/owlfolio-local-backup-cli.ts verify-restore"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.1",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "4.1.7"
  }
}
