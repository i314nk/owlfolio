[Unit]
Description=Owlfolio Investment Agent Daemon
After=network.target

[Service]
Type=simple
User=YOUR_USERNAME
WorkingDirectory=/home/YOUR_USERNAME/owlfolio
ExecStart=/home/YOUR_USERNAME/owlfolio/.venv/bin/python -m src.main daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
