# Investment Agent — Environment Variables
# Copy to .env and fill in your values.

# LLM Provider
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Financial data APIs (free tiers)
# FMP_API_KEY=...           # financialmodelingprep.com
# FRED_API_KEY=...          # fred.stlouisfed.org

# SEC EDGAR requires a User-Agent with your email
SEC_EDGAR_USER_AGENT="Investment Agent your-email@example.com"

# Voice input (optional) — local Whisper transcription, no data leaves your machine
# WHISPER_MODEL=base          # Options: tiny, base, small, medium, large-v3
# WHISPER_DEVICE=cpu          # Options: cpu, cuda (GPU)
